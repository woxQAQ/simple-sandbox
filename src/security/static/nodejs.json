{
  "language": "nodejs",
  "description": "Node.js语言的系统调用白名单配置",
  "defaultAction": "SCMP_ACT_ERRNO",
  "architectures": [
    "SCMP_ARCH_X86_64"
  ],
  "syscalls": [
    {
      "names": [
        "close",
        "write",
        "read",
        "fstat",
        "fcntl",
        "readlinkat",
        "openat",
        "getpid",
        "tgkill",
        "futex",
        "ioctl",
        "exit",
        "exit_group",
        "set_robust_list",
        "nanosleep",
        "sched_getaffinity",
        "sched_yield",
        "rt_sigprocmask",
        "sigaltstack",
        "rt_sigaction",
        "mmap",
        "munmap",
        "madvise",
        "mprotect",
        "rt_sigreturn",
        "brk",
        "setuid",
        "setgid",
        "gettid",
        "getuid",
        "getgid",
        "epoll_ctl",
        "epoll_pwait",
        "clone",
        "socket",
        "connect",
        "bind",
        "listen",
        "accept",
        "sendto",
        "recvfrom",
        "getsockname",
        "setsockopt",
        "getsockopt",
        "sendmmsg",
        "recvmsg",
        "getpeername",
        "ppoll",
        "uname",
        "fstatat",
        "lseek",
        "fstatfs"
      ],
      "action": "SCMP_ACT_ALLOW"
    }
  ]
}

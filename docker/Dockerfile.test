# Dockerfile.test - Optimized for testing
# Based on the main Dockerfile for consistency

FROM python:3.11-slim

# Install build and test dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libseccomp-dev \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Install Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs

WORKDIR /app

# Copy dependency files first for better caching
COPY pyproject.toml uv.lock ./
COPY scripts/ ./scripts/

# Install Python dependencies including test dependencies
RUN pip install -e . && \
    pip install pytest pytest-cov

# Copy source code and tests
COPY src/ ./src/
COPY tests/ ./tests/

# Build seccomp components (same as main Dockerfile)
RUN chmod +x ./scripts/build.sh && ./scripts/build.sh

# Install Node.js transformer dependencies
RUN cd src/runtime/nodejs && npm install

# Create sandbox directories
RUN mkdir -p /var/sandbox/python /var/sandbox/nodejs

# Set environment variables
ENV PYTHONPATH=/app
ENV NODE_PATH=/app/src/runtime/nodejs
ENV PYTHONUNBUFFERED=1

# Expose port
EXPOSE 8000

# Default test command
CMD ["python", "-m", "pytest", "tests/", "-v", "--cov=src", "--cov-report=term-missing"]

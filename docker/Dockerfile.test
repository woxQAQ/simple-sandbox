# Dockerfile.test - Optimized for testing
# Based on the main Dockerfile for consistency

FROM python:3.11-slim

# Install build and test dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libseccomp-dev \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Install Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs

WORKDIR /app

# Copy dependency files first for better caching
COPY pyproject.toml uv.lock ./
COPY scripts/ ./scripts/

# Install Python dependencies including test dependencies
RUN pip install -e . && \
    pip install pytest pytest-cov

# Copy source code, tests, and main application
COPY src/ ./src/
COPY tests/ ./tests/
COPY main.py ./

# Build seccomp components (same as main Dockerfile)
RUN chmod +x ./scripts/build.sh && ./scripts/build.sh

# Install Node.js transformer dependencies
RUN cd src/runtime/nodejs && npm install && \
    # Ensure acorn is properly built
    cd node_modules/acorn && \
    if [ ! -d "dist" ]; then \
        npm install && \
        npm run prepare; \
    fi

# Create sandbox directories and copy seccomp libraries
RUN mkdir -p /var/sandbox/python /var/sandbox/nodejs && \
    cp /app/build/lib/libseccomp_injector_python.so /var/sandbox/python/ && \
    cp /app/build/lib/libseccomp_injector_nodejs.so /var/sandbox/nodejs/

# Create non-root user for security (but don't switch to it)
RUN useradd -m -u 1000 sandbox && \
    chown -R sandbox:sandbox /app /var/sandbox

# Set environment variables
ENV PYTHONPATH=/app
ENV NODE_PATH=/app/src/runtime/nodejs
ENV PYTHONUNBUFFERED=1
ENV TEST_MODE=false

# Expose port
EXPOSE 8000

# Default test command
CMD ["python", "-m", "pytest", "tests/", "-v", "--cov=src", "--cov-report=term-missing"]

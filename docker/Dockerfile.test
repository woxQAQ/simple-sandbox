# Dockerfile.test - Optimized for testing
# Based on the main Dockerfile for consistency

FROM python:3.11-slim

# Install build and test dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libseccomp-dev \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Install Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs

WORKDIR /app

# Copy dependency files first for better caching
COPY pyproject.toml uv.lock ./
COPY scripts/ ./scripts/

# Install Python dependencies including test dependencies
RUN pip install -e . && \
    pip install pytest pytest-cov

# Copy source code, tests, and main application
COPY src/ ./src/
COPY tests/ ./tests/
COPY main.py ./

# Build seccomp components (same as main Dockerfile)
RUN chmod +x ./scripts/build.sh && ./scripts/build.sh

# Install Node.js dependencies
RUN cd src/runtime/nodejs/node_runtime && npm install

# Create sandbox directories and copy seccomp libraries
RUN mkdir -p /var/sandbox/python /var/sandbox/nodejs/runtime/ && \
    cp /app/build/lib/libseccomp_injector_python.so /var/sandbox/python/ && \
    cp /app/build/lib/libseccomp_injector_nodejs.so /var/sandbox/nodejs/

COPY src/runtime/nodejs/node_runtime /var/sandbox/nodejs/runtime

# Create non-root user for security (but don't switch to it)
RUN useradd -m -u 1000 sandbox && \
    chown -R sandbox:sandbox /app /var/sandbox

# Set environment variables
ENV PYTHONPATH=/app
ENV SANDBOX_USER_ID=1000
ENV SANDBOX_GROUP_ID=1000
ENV NODE_PATH=/app/src/runtime/nodejs
ENV PYTHONUNBUFFERED=1
ENV TEST_MODE=false

# Expose port
EXPOSE 8000

# Default command
CMD ["python", "main.py", "--port", "8000"]

# Dockerfile.test - 简化版用于e2e测试
# 单架构构建，与主Dockerfile保持一致

# Build stage
FROM python:3.11.13-slim-bookworm AS builder
ARG DEBIAN_MIRROR="http://deb.debian.org/debian"
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY scripts/ ./scripts/
COPY src/ ./src/

# 安装构建依赖
RUN echo "deb ${DEBIAN_MIRROR} bookworm main" > /etc/apt/sources.list && \
    apt update && apt install -y --no-install-recommends \
    libseccomp-dev \
    libsqlite3-0 \
    zlib1g \
    pkg-config \
    curl \
    build-essential \
    && apt clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

RUN uv venv /opt/venv --python 3.11 \
    && . /opt/venv/bin/activate \
    && uv sync --active

RUN ./scripts/build.sh

# build transformer package
FROM node:20.11.0 AS node_builder

WORKDIR /app
COPY src/ ./src/
RUN cd src/runtime/transformer/nodejs && npm install

# Final Stage
FROM python:3.11.13-slim

# 重新声明ARG变量
ARG DEBIAN_MIRROR="http://deb.debian.org/debian"
ENV NODEJS_VERSION=v20.11.0

RUN echo "deb ${DEBIAN_MIRROR} bookworm main" > /etc/apt/sources.list && \
    rm -f /etc/apt/sources.list.d/debian.sources && \
    apt update && apt install -y --no-install-recommends \
    wget \
    curl \
    libseccomp-dev \
    libsqlite3-0 \
    zlib1g \
    pkg-config \
    xz-utils \
    && apt clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

COPY . /app
COPY .env.example /app/.env

RUN /app/scripts/install_nodejs.sh amd64

# copy language runtime from builder
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /var/sandbox /var/sandbox

ENV PATH="/opt/venv/bin:/opt/node/bin:$PATH"

# COPY --from=builder /app/build/lib /app/build/lib
COPY --from=node_builder /app/src/runtime/transformer/nodejs/node_modules /app/src/runtime/transformer/nodejs/node_modules
WORKDIR /app

RUN . /opt/venv/bin/activate && pip install --no-deps -e . && \
    pip install matplotlib numpy && \
    rm -rf /tmp/*

# 创建非root用户
# RUN useradd -m -u 1000 sandbox && chown -R sandbox:sandbox /app
# USER sandbox

# 暴露端口
EXPOSE 8000

ENV TARGET_ARCH="amd64"

ENTRYPOINT [ "/app/scripts/entrypoint.sh" ]

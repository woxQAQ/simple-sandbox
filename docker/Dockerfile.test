# Dockerfile.test - 简化版用于e2e测试
# 避免使用buildx，专注于快速构建测试镜像

FROM python:3.11-slim

# 安装基础依赖
RUN apt update && apt install -y --no-install-recommends \
    curl \
    wget \
    xz-utils \
    build-essential \
    && apt clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# 安装Node.js
RUN curl -fsSL https://nodejs.org/dist/v20.11.0/node-v20.11.0-linux-x64.tar.xz | tar -xJ -C /usr/local --strip-components=1

# 安装uv
RUN pip install uv

# 设置工作目录
WORKDIR /app

# 复制项目文件
COPY . /app/

# 安装Python依赖
RUN uv venv /opt/venv --python 3.11
RUN . /opt/venv/bin/activate && uv sync

# 安装Node.js依赖
RUN cd src/runtime/transformer/nodejs && npm install

# 设置环境变量
ENV PATH="/opt/venv/bin:/usr/local/bin:$PATH"
ENV PYTHONPATH="/app/src"

# 构建必要的组件
RUN . /opt/venv/bin/activate && pip install --no-deps -e .

# 构建seccomp共享库
RUN cd src/security/bpf && make

# 创建非root用户
RUN useradd -m -u 1000 sandbox && chown -R sandbox:sandbox /app
USER sandbox

# 暴露端口
EXPOSE 8000

# 启动命令
CMD ["python", "main.py", "--port", "8000"]
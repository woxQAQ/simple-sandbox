# E2E测试环境变量配置
# 容器配置
E2E_CONTAINER__IMAGE_NAME=code-sandbox:latest
E2E_CONTAINER__CONTAINER_NAME=code-sandbox-e2e-test
E2E_CONTAINER__HOST_PORT=8000
E2E_CONTAINER__CONTAINER_PORT=8000
E2E_CONTAINER__ENABLED=true

# API配置
E2E_API__BASE_URL=http://localhost:8000
E2E_API__HEALTH_ENDPOINT=/api/v1/health
E2E_API__EXECUTE_ENDPOINT=/api/v1/execute
E2E_API__TIMEOUT=30

# 测试配置
E2E_TEST__MAX_WAIT_TIME=60
E2E_TEST__WAIT_INTERVAL=2
E2E_TEST__OUTPUT_DIR=reports
E2E_TEST__VERBOSE=false
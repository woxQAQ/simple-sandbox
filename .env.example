# Backend selection: docker | cri | k8s
SANDBOX_BACKEND=docker

# Concurrency and queue control
SANDBOX_MAX_CONCURRENCY=4
SANDBOX_MAX_QUEUE=32

# Language runtime images (registry/repository:tag)
SANDBOX_IMAGE_PYTHON_REGISTRY=docker.io
SANDBOX_IMAGE_PYTHON_REPOSITORY=sandbox-python
SANDBOX_IMAGE_PYTHON_TAG=latest

SANDBOX_IMAGE_NODE_REGISTRY=docker.io
SANDBOX_IMAGE_NODE_REPOSITORY=sandbox-node
SANDBOX_IMAGE_NODE_TAG=latest

# CRI runtime settings
# Default containerd socket; change if different (e.g., crio)
SANDBOX_CRI_SOCKET=unix:///run/containerd/containerd.sock

# CRI seccomp mode per backend (runtimeDefault | unconfined | localhost)
SANDBOX_CRI_SECCOMP_MODE=runtimeDefault
# Optional per-language overrides (uncomment to use localhost profiles on node filesystem)
# SANDBOX_CRI_SECCOMP_MODE_PYTHON=localhost
# SANDBOX_CRI_SECCOMP_LOCALHOST_REF_PYTHON=/var/lib/seccomp/python.json
# SANDBOX_CRI_SECCOMP_MODE_NODE=localhost
# SANDBOX_CRI_SECCOMP_LOCALHOST_REF_NODE=/var/lib/seccomp/node.json

# Kubernetes settings
# In-cluster config is used by default; otherwise ~/.kube/config is used
# K8s seccomp mode (runtimeDefault | unconfined | localhost)
SANDBOX_K8S_SECCOMP_MODE=runtimeDefault
# Optional per-language overrides (for localhost profile paths on the node)
# SANDBOX_K8S_SECCOMP_MODE_PYTHON=localhost
# SANDBOX_K8S_SECCOMP_LOCALHOST_REF_PYTHON=profiles/python.json
# SANDBOX_K8S_SECCOMP_MODE_NODE=localhost
# SANDBOX_K8S_SECCOMP_LOCALHOST_REF_NODE=profiles/node.json

# Note: HTTP listen address is a flag (-addr), not env. Example: `-addr :8080`
